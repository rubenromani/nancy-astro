---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { LANGS, type Lang } from '../../i18n/ui';
import { useTranslations, assetPath } from '../../i18n/utils';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

// Convert **bold** markers into <strong> tags safely
function md(text: string): string {
  const escape = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));
  return escape(text).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}
---

<Layout title={t.info.pageTitle} lang={lang} pathSlug="info">
  <Header lang={lang} pathSlug="info" />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16 relative">
    <div class="text-center mb-10 md:mb-12">
      <h1 class="font-headline text-3xl sm:text-5xl md:text-7xl font-extrabold text-primary rotated-heading mb-4">
        {t.info.title}
      </h1>
      <span class="material-symbols-outlined text-primary/40 text-4xl">schedule</span>
    </div>

    <div class="flex flex-col md:flex-row gap-12 items-start">
      <div class="flex-1 space-y-8">
        <div class="border-b border-dashed border-primary/20 pb-6">
          <h3 class="font-headline text-xl sm:text-2xl font-bold text-primary mb-2">{t.info.hoursTitle}</h3>
          <p class="font-body text-base sm:text-lg" set:html={md(t.info.hoursBody)} />
          <p class="font-script text-on-surface-variant text-xl sm:text-2xl mt-2">
            {t.info.hoursKitchen}
          </p>
        </div>

        <div class="border-b border-dashed border-primary/20 pb-6">
          <h3 class="font-headline text-xl sm:text-2xl font-bold text-primary mb-2">{t.info.summerTitle}</h3>
          <p class="font-body text-base sm:text-lg" set:html={md(t.info.summerBody)} />
          <p class="font-body text-base sm:text-lg mt-2">
            {t.info.summerCall}
            <a href="tel:+390541601718" class="text-primary font-bold underline decoration-dashed underline-offset-4">0541-601718</a>.
          </p>
        </div>

        <div class="border-b border-dashed border-primary/20 pb-6">
          <h3 class="font-headline text-xl sm:text-2xl font-bold text-primary mb-2">{t.info.lunchTitle}</h3>
          <p class="font-body text-base sm:text-lg">
            {t.info.lunchBody}
          </p>
          <p class="font-script text-sketch-red text-xl sm:text-2xl mt-3 -rotate-1 inline-block">
            {t.info.lunchPunchline}
          </p>
        </div>

        <div class="pb-6">
          <h3 class="font-headline text-xl sm:text-2xl font-bold text-primary mb-2">{t.info.takeawayTitle}</h3>
          <p class="font-body text-base sm:text-lg">
            {t.info.takeawayBody}
          </p>
          <p class="font-script text-on-surface-variant text-xl sm:text-2xl mt-2 italic">
            {t.info.takeawayPunch}
          </p>
        </div>
      </div>

      <div class="w-full md:w-2/5 flex justify-center md:mt-4">
        <div class="sketchy-img-container -rotate-2 relative">
          <div class="scrapbook-pin" style="background: #c63737"></div>
          <img
            src={assetPath('img/foto7.jpg')}
            alt="Nancy Riccione"
            class="w-full h-auto aspect-[4/5] object-cover hand-cut-img"
          />
        </div>
      </div>
    </div>

    <Footer lang={lang} />
  </main>
</Layout>
