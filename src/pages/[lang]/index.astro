---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { LANGS, languages, type Lang } from '../../i18n/ui';
import { useTranslations, localizedPath, assetPath } from '../../i18n/utils';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Layout title={`Nancy Riccione — ${t.hero.title}`} lang={lang} pathSlug="">
  <Header showLogo={false} lang={lang} pathSlug="" showLangSwitcher={false} />

  <main class="max-w-6xl mx-auto px-6 py-12 md:py-16">
    <div class="flex flex-col items-center mb-8 md:mb-12">
      <img src={assetPath('img/logo.png')} alt={t.home.altLogo} class="h-24 sm:h-32 md:h-44 w-auto" />
    </div>

    <div class="md:hidden flex flex-col items-center mb-8 gap-5">
      <a
        href={localizedPath(lang, 'menu')}
        class="bg-[#fff9ed] border-2 border-dashed border-primary text-primary font-headline text-2xl sm:text-3xl font-bold px-8 py-4 rounded-full shadow-2xl hover:bg-primary hover:text-white transition-colors rotate-[-2deg]"
      >
        {t.home.goToMenu}
      </a>
      <div class="flex flex-col items-center gap-2">
        <div class="flex justify-center gap-2">
          {LANGS.slice(0, 3).map((l) => (
            <a
              href={localizedPath(l, 'menu')}
              aria-label={languages[l].label}
              class={`flex items-center gap-2 bg-[#fff9ed] border-2 border-dashed text-primary font-headline font-bold px-3 py-2 rounded-full shadow-md hover:bg-primary hover:text-white transition-colors ${l === lang ? 'border-primary rotate-[-1deg]' : 'border-primary/50'}`}
            >
              <img src={assetPath(`img/flags/${languages[l].flag}.svg`)} alt="" class="w-6 h-4 object-cover rounded-sm border border-[#30407a]/20" />
              <span class="text-xs sm:text-sm">{languages[l].label}</span>
            </a>
          ))}
        </div>
        <div class="flex justify-center gap-2">
          {LANGS.slice(3).map((l) => (
            <a
              href={localizedPath(l, 'menu')}
              aria-label={languages[l].label}
              class={`flex items-center gap-2 bg-[#fff9ed] border-2 border-dashed text-primary font-headline font-bold px-3 py-2 rounded-full shadow-md hover:bg-primary hover:text-white transition-colors ${l === lang ? 'border-primary rotate-[-1deg]' : 'border-primary/50'}`}
            >
              <img src={assetPath(`img/flags/${languages[l].flag}.svg`)} alt="" class="w-6 h-4 object-cover rounded-sm border border-[#30407a]/20" />
              <span class="text-xs sm:text-sm">{languages[l].label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="relative">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10 items-stretch">
        <div class="sketchy-img-container rotate-1 relative">
          <div class="scrapbook-pin"></div>
          <img
            src={assetPath('img/foto7.jpg')}
            alt="Nancy Riccione"
            class="w-full aspect-[4/5] object-cover hand-cut-img"
          />
        </div>
        <div class="sketchy-img-container -rotate-1 relative">
          <div class="scrapbook-pin" style="background: #c63737"></div>
          <img
            src={assetPath('img/foto9.jpg')}
            alt="Nancy Riccione"
            class="w-full aspect-[4/5] object-cover hand-cut-img"
          />
        </div>
      </div>

      <div class="hidden md:flex absolute inset-0 flex-col items-center justify-center pointer-events-none px-4 gap-5">
        <a
          href={localizedPath(lang, 'menu')}
          class="pointer-events-auto bg-[#fff9ed] border-2 border-dashed border-primary text-primary font-headline text-4xl lg:text-5xl font-bold px-12 lg:px-16 py-6 lg:py-7 rounded-full shadow-2xl hover:bg-primary hover:text-white transition-colors rotate-[-2deg]"
        >
          {t.home.goToMenu}
        </a>
        <div class="pointer-events-auto flex flex-col items-center gap-2 lg:gap-3">
          <div class="flex justify-center gap-2 lg:gap-3">
            {LANGS.slice(0, 3).map((l) => (
              <a
                href={localizedPath(l, 'menu')}
                aria-label={languages[l].label}
                class={`flex items-center gap-2 bg-[#fff9ed] border-2 border-dashed text-primary font-headline font-bold px-3 lg:px-4 py-2 rounded-full shadow-lg hover:bg-primary hover:text-white transition-colors ${l === lang ? 'border-primary rotate-[-1deg]' : 'border-primary/50'}`}
              >
                <img src={assetPath(`img/flags/${languages[l].flag}.svg`)} alt="" class="w-6 h-4 lg:w-7 lg:h-5 object-cover rounded-sm border border-[#30407a]/20" />
                <span class="text-xs lg:text-sm">{languages[l].label}</span>
              </a>
            ))}
          </div>
          <div class="flex justify-center gap-2 lg:gap-3">
            {LANGS.slice(3).map((l) => (
              <a
                href={localizedPath(l, 'menu')}
                aria-label={languages[l].label}
                class={`flex items-center gap-2 bg-[#fff9ed] border-2 border-dashed text-primary font-headline font-bold px-3 lg:px-4 py-2 rounded-full shadow-lg hover:bg-primary hover:text-white transition-colors ${l === lang ? 'border-primary rotate-[-1deg]' : 'border-primary/50'}`}
              >
                <img src={assetPath(`img/flags/${languages[l].flag}.svg`)} alt="" class="w-6 h-4 lg:w-7 lg:h-5 object-cover rounded-sm border border-[#30407a]/20" />
                <span class="text-xs lg:text-sm">{languages[l].label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <Footer lang={lang} />
  </main>
</Layout>
