---
import { LANGS, DEFAULT_LANG } from '../i18n/ui';
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const fallback = `${base}/${DEFAULT_LANG}/storia`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nancy Riccione</title>
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    <script is:inline define:vars={{ base, langs: LANGS, fallback }}>
      (function () {
        try {
          var nav = (navigator.language || navigator.userLanguage || '').toLowerCase().split('-')[0];
          var target = langs.indexOf(nav) >= 0 ? nav : 'en';
          window.location.replace(base + '/' + target + '/storia');
        } catch (e) {
          window.location.replace(fallback);
        }
      })();
    </script>
  </head>
  <body><p style="font-family:sans-serif;text-align:center;padding:2rem">Redirecting…</p></body>
</html>
