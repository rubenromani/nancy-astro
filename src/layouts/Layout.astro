---
import '../styles/global.css';
import { LANGS, type Lang, DEFAULT_LANG } from '../i18n/utils';

interface Props {
  title?: string;
  lang?: Lang;
  pathSlug?: string; // e.g. '', 'menu', 'storia' — used for hreflang
}

const { title = 'Nancy Riccione — Sapori dell\'Adriatico', lang = DEFAULT_LANG, pathSlug = '' } = Astro.props;

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const site = (import.meta.env.SITE ?? '') as string;
const slug = pathSlug ? `/${pathSlug.replace(/^\//, '')}` : '/';

const alternates = LANGS.map((l) => ({
  lang: l,
  href: `${site}${base}/${l}${slug === '/' ? '/' : slug}`,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${site}${base}${slug === '/' ? '/' : slug}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,700;0,800;1,700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Caveat:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background text-on-surface font-body selection:bg-secondary-container relative">
    <!-- Paper grain overlay -->
    <div class="fixed inset-0 pointer-events-none paper-grain z-[100]"></div>

    <slot />

    <!-- SVG filter for hand-drawn effect -->
    <svg height="0" style="position:absolute; pointer-events:none;" width="0">
      <defs>
        <filter height="120%" id="hand-drawn" width="120%" x="-10%" y="-10%">
          <feTurbulence baseFrequency="0.02" numOctaves="3" result="noise" type="fractalNoise"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="3"></feDisplacementMap>
        </filter>
      </defs>
    </svg>
  </body>
</html>
