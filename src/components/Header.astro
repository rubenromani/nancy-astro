---
import { languages, LANGS, DEFAULT_LANG, type Lang } from '../i18n/ui';
import { useTranslations, localizedPath, assetPath } from '../i18n/utils';

interface Props {
  showLogo?: boolean;
  lang?: Lang;
  pathSlug?: string; // current page slug for language switch (without lang prefix)
  showLangSwitcher?: boolean;
}
const { showLogo = true, lang = DEFAULT_LANG, pathSlug = '', showLangSwitcher = true } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
  { slug: 'storia', label: t.nav.history },
  { slug: 'menu', label: t.nav.menu },
  { slug: 'aperitivo', label: t.nav.aperitivo },
  { slug: 'info', label: t.nav.info },
];

const currentFlag = languages[lang].flag;
---

<header class="flex justify-between items-center w-full px-4 sm:px-6 py-3 sm:py-4 sticky top-0 z-50 backdrop-blur-md bg-[#fff9ed]/90 border-b border-dashed border-[#30407a]/20">
  <div class="relative">
    <button
      id="nav-toggle"
      type="button"
      aria-label={t.nav.openMenu}
      class="flex items-center gap-2 text-primary hover:opacity-80 transition-opacity"
    >
      <span class="material-symbols-outlined text-3xl">menu</span>
    </button>

    <nav
      id="nav-dropdown"
      class="hidden absolute left-0 top-full mt-2 bg-[#fff9ed] border border-dashed border-[#30407a]/30 rounded-2xl shadow-2xl p-4 min-w-[220px] z-50"
    >
      <ul class="flex flex-col gap-2">
        {navLinks.map((link) => (
          <li>
            <a
              href={localizedPath(lang, link.slug)}
              class="block px-3 py-2 rounded-lg text-[#1f1c0b] hover:bg-primary/10 hover:text-primary transition-colors font-bold tracking-wide"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {showLogo ? (
    <a href={localizedPath(lang, '')} class="flex items-center">
      <img src={assetPath('img/logo.png')} alt={t.home.altLogo} class="h-9 sm:h-10 md:h-12 w-auto" />
    </a>
  ) : (
    <div></div>
  )}

  {showLangSwitcher ? (
    <div class="relative">
      <button
        id="lang-toggle"
        type="button"
        aria-label={t.nav.langSelector}
        class="flex items-center gap-1 text-primary hover:opacity-80 transition-opacity p-1 rounded-md"
      >
        <img src={assetPath(`img/flags/${currentFlag}.svg`)} alt={languages[lang].label} class="w-7 h-5 object-cover rounded-sm border border-[#30407a]/20" />
        <span class="material-symbols-outlined text-xl">expand_more</span>
      </button>
      <div
        id="lang-dropdown"
        class="hidden absolute right-0 top-full mt-2 bg-[#fff9ed] border border-dashed border-[#30407a]/30 rounded-2xl shadow-2xl p-2 min-w-[160px] z-50"
      >
        <ul class="flex flex-col gap-1">
          {LANGS.map((l) => (
            <li>
              <a
                href={localizedPath(l, pathSlug)}
                class={`flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-primary/10 transition-colors font-bold tracking-wide ${l === lang ? 'bg-primary/5 text-primary' : 'text-[#1f1c0b]'}`}
              >
                <img src={assetPath(`img/flags/${languages[l].flag}.svg`)} alt="" class="w-6 h-4 object-cover rounded-sm border border-[#30407a]/20" />
                <span>{languages[l].label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  ) : (
    <div class="w-8"></div>
  )}
</header>

<script is:inline>
  (function () {
    const toggle = document.getElementById('nav-toggle');
    const dropdown = document.getElementById('nav-dropdown');
    const langToggle = document.getElementById('lang-toggle');
    const langDropdown = document.getElementById('lang-dropdown');

    function close(el) { if (el) el.classList.add('hidden'); }

    if (toggle && dropdown) {
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('hidden');
        close(langDropdown);
      });
    }
    if (langToggle && langDropdown) {
      langToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        langDropdown.classList.toggle('hidden');
        close(dropdown);
      });
    }
    document.addEventListener('click', (e) => {
      if (dropdown && !dropdown.contains(e.target) && toggle && !toggle.contains(e.target)) close(dropdown);
      if (langDropdown && !langDropdown.contains(e.target) && langToggle && !langToggle.contains(e.target)) close(langDropdown);
    });
  })();
</script>
